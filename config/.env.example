# Copy to config/.env and fill in. Never commit the real .env.
# Credentials are read from the environment at runtime — never hard-coded.

CMS_BASE_URL=http://cms.intsmarthub.com:31597
CMS_LOGIN_URL=http://cms.intsmarthub.com:31597/microop/user/login/
CMS_OTA_URL=http://cms.intsmarthub.com:31597/basicservice/otamanage/upgrade-ota
CMS_USERNAME=__set_me__
CMS_PASSWORD=__set_me__

# DASS data-reporting site (phase M4)
DASS_URL=http://52.24.159.106:8080/dass/ReportServer?op=fs
DASS_USERNAME=__set_me__
DASS_PASSWORD=__set_me__

# Run with a visible browser (true) for first-time setup / debugging, or
# headless (false) once the flow is stable.
CMS_HEADED=true

# Where to drop per-step screenshots and the recovered Rule IDs.
CMS_ARTIFACTS_DIR=./artifacts
