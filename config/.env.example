# Copy to config/.env and fill in. Never commit the real .env.
# Credentials are read from the environment at runtime — never hard-coded.

CMS_BASE_URL=http://cms.intsmarthub.com:31597
CMS_LOGIN_URL=http://cms.intsmarthub.com:31597/microop/user/login/
CMS_OTA_URL=http://cms.intsmarthub.com:31597/basicservice/otamanage/upgrade-ota
CMS_USERNAME=__set_me__
CMS_PASSWORD=__set_me__

# DASS data-reporting site (phase M4)
DASS_URL=http://52.24.159.106:8080/dass/ReportServer?op=fs
DASS_LOGIN_URL=http://52.24.159.106:8080/dass/ReportServer?op=fs_load&cmd=fs_signin
DASS_USERNAME=__set_me__
DASS_PASSWORD=__set_me__

# Run with a visible browser (true) for first-time setup / debugging, or
# headless (false) once the flow is stable.
CMS_HEADED=true

# Where to drop per-step screenshots and the recovered Rule IDs.
CMS_ARTIFACTS_DIR=./artifacts

# OTA 工作目录（统一工作环境根）：生成的 Excel（prep 未给 --out-dir 且未用 --file 时）、
# 部署数据库(OTADATA) 等默认都落在此目录下。
OTA_WORKSPACE=/Users/devinwang/Documents/海信运维交接/OTA升级部署

# OTA template prep (automation.prep): FTP download of upgrade .zip packages.
OTA_FTP_USER=ftpuser
OTA_FTP_PASS=__set_me__
# Optional overrides (defaults shown); leave commented to use the built-in defaults:
# OTA_S3_UPLOAD_BUCKET=fam-media-andr
# OTA_AWS_PREFIX=https://ota-dl.vidaahub.com
# NOTE: AWS region/keys are NOT set here. prep uploads via boto3's default
# credential chain (~/.aws / instance role / env). Region is us-west.

# 部署汇总邮件（dass init 之后发送 HTML 汇总）。不填 OTA_SMTP_HOST 就不发，只保存 HTML 文件。
OTA_SMTP_HOST=
# 465 = SSL；587 = STARTTLS（默认）；25 = 一般不加密
OTA_SMTP_PORT=587
# ssl / starttls / none（不填按端口推断）
OTA_SMTP_SECURITY=
OTA_SMTP_USER=
OTA_SMTP_PASS=
# 发件人（默认 = OTA_SMTP_USER）
OTA_MAIL_FROM=
# 每封固定抄送 / 固定密送（不填用默认值；To 里出现这些地址会自动去掉）
OTA_MAIL_CC=数据统计报告 <sys.datareports@hisense.com>
OTA_MAIL_BCC=王涛/Devin Wang <devinw@hisense.com>
